{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "eslint/no-underscore-dangle": [
      "warn",
      { "allow": ["_min", "_max", "_avg", "_sum", "_count", "_all"] }
    ]
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "server/src/generated/**"]
}
