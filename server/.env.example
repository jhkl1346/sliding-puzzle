# 실제 값은 server/.env에 적고, 이 파일에는 키 이름과 예시만 남긴다.
PORT=3000
# Neon 풀링 접속 주소: 서버가 평소에 쓴다 (예: postgresql://사용자:비밀번호@ep-xxx-pooler.지역.aws.neon.tech/neondb?sslmode=verify-full)
DATABASE_URL=
# Neon 직접 접속 주소(-pooler 없는 주소): Prisma 마이그레이션에 쓴다
DIRECT_URL=
CLIENT_ORIGIN=http://localhost:5173
# 앞단 프록시를 몇 단계까지 믿을지. 로컬은 0, 배포(Vercel → Render)는 README의 배포 안내 참고
TRUST_PROXY=0

# JWT 서명용 비밀 키 (32자 이상). 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 테스트 전용 DB (npm test가 데이터를 지우고 다시 채운다). DB 이름이 _test로 끝나야 테스트가 실행된다.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
